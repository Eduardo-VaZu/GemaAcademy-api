  "item": [
    {
      "name": "Auth - 1. Ingresos al Sistema",
      "item": [
        {
          "name": "Login - 👨🏻‍💻 Como Administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin123\",\n    \"password\": \"Admin_Password_123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - 👨🏻‍🏫 Como Profesor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"profesor456\",\n    \"password\": \"Profe_Gema_2025\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - 🧑🏻‍🎓 Como Alumno Regular",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"alumno789\",\n    \"password\": \"AlumnoSeguro!1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Alumno que ya tiene su correo registrado, puede ver su perfil completo de inmediato."
          }
        },
        {
          "name": "Login - 🧑🏻‍🎓 Como Alumno Nuevo (Sin Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"alumno_nuevo_migrado\",\n    \"password\": \"Temporal123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Alumno de registro masivo, forzará a entrar al endpoint /completar-email."
          }
        }
      ]
    },
    {
      "name": "Auth - 2. Sesiones y Tokens Públicos",
      "item": [
        {
          "name": "Refrescar Token Oculto",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Cerrar Sesión Dispositivo Actual",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth - 3. Zona Privada (Requiere AccessToken)",
      "item": [
        {
          "name": "Obtener la Data Del Perfil 🔥",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "El output de este request variará de acuerdo a cuál de los 4 Logins hiciste en el paso anterior (Admin dará su sede, Profe su tarifa, Alumno su seguro médico, etc)."
          }
        },
        {
          "name": "Completar Email Forzado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"correo_vital_nuevo@gema.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/completar-email",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "completar-email"]
            }
          }
        },
        {
          "name": "Pánico Global - Cerrar TODAS mis sesiones",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout-all"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth - 4. Recuperación de Cuenta",
      "item": [
        {
          "name": "Paso 1: Solicitar Enlace (Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"alumno789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Paso 2: Digitar Nueva Clave Segura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"token\": \"ey...PEGA_AQUÍ_EL_TOKEN_DE_UNA_HORA...\",\n    \"newPassword\": \"Mi_Clave_Mas_Dura_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            }
          }
        }
      ]
    }
