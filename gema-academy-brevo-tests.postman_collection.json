{
  "info": {
    "_postman_id": "c7a8b9f1-d4e5-4f6a-9b8c-7d6e5f4a3b2c",
    "name": "GemaAcademy - Pruebas Brevo Email (Antigravity)",
    "description": "Colección de pruebas para validar la integración de Brevo API v3 en la arquitectura Antigravity. Evalúa el zero-blocking en los flujos de creación de usuarios y password-reset.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Flujo de Recuperación (Forgot Password)",
      "item": [
        {
          "name": "Solicitar Recuperación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\" \n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/forgot-password",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Debe devolver 200 OK y disparar el emailService.sendPasswordRecoveryEmail() hacia Brevo. El tiempo de respuesta no debe exceder los 5000ms."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Flujo de Creación (Credentials Email)",
      "item": [
        {
          "name": "Crear Alumno (Con Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}",
                "description": "Token de un administrador válido"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombres\": \"Eduardo\",\n    \"apellidos\": \"Vargas Zumaeta\",\n    \"email\": \"vargaseduardo687@gmail.com\",\n    \"rol_id\": \"ALUMNO\",\n    \"tipo_documento_id\": \"DNI\",\n    \"numero_documento\": \"12345678\",\n    \"fecha_nacimiento\": \"2005-08-15\",\n    \"genero\": \"M\",\n    \"datosRolEspecifico\": {\n        \"direccion\": {\n            \"direccion_completa\": \"Av. Universitaria 123\",\n            \"distrito\": \"San Miguel\"\n        }\n    }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/usuarios/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "usuarios", "register"]
            },
            "description": "Crea un usuario y gracias a la arquitectura Antigravity, debería retornar HTTP 201 casi de inmediato (en milisegundos) e invocar a Brevo en background (Fire and Forget) con emailService.sendCredentialsEmail()."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "TU_TOKEN_AQUI",
      "type": "string"
    }
  ]
}
